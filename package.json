{
    "name": "template-hono",
    "private": true,
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prebuild": "pnpm run cf-typegen",
        "preview": "pnpm run build && vite preview",
        "deploy": "pnpm run build && wrangler deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings",
        "postinstall": "pnpm run cf-typegen && pnpm exec simple-git-hooks",
        "format": "biome format --write .",
        "lint": "biome check .",
        "check": "pnpm run format && pnpm run lint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@hono/zod-openapi": "^1.1.4",
        "@scalar/hono-api-reference": "^0.9.24",
        "hono": "^4.10.5",
        "hono-openapi": "^1.1.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.5",
        "@cloudflare/vite-plugin": "^1.14.1",
        "@cloudflare/vitest-pool-workers": "^0.12.1",
        "@edge-runtime/vm": "^5.0.0",
        "@vitest/coverage-istanbul": "~3.2.4",
        "cross-env": "^10.1.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "~3.2.4",
        "wrangler": "^4.47.0"
    },
    "packageManager": "pnpm@10.16.1+sha512.0e155aa2629db8672b49e8475da6226aa4bdea85fdcdfdc15350874946d4f3c91faaf64cbdc4a5d1ab8002f473d5c3fcedcd197989cf0390f9badd3c04678706"
}

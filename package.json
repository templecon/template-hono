{
    "name": "template-hono",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "concertypin",
        "url": "https://github.com/concertypin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/templecon/template-hono"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "pnpm run lint:oxlint --fix",
        "lint:check": "pnpm run lint:oxlint",
        "lint:oxlint": "oxlint -c oxlint.config.ts . --type-aware --type-check --report-unused-disable-directives-severity=error",
        "postinstall": "pnpm run cf-typegen && simple-git-hooks",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "test": "vitest run",
        "deploy": "pnpm run build && wrangler deploy"
    },
    "engines": {
        "node": ">=26"
    },
    "dependencies": {
        "@hono/standard-validator": "^0.4.0",
        "@scalar/hono-api-reference": "^0.12.10",
        "hono": "^4.13.13",
        "hono-openapi": "^1.3.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.62.5",
        "@cloudflare/vitest-plugin": "^1.3.6",
        "@concertypin/config": "^0.4.0",
        "@types/node": "^26.6.4",
        "@vitest/coverage-istanbul": "^4.1.11",
        "cross-env": "^10.1.0",
        "globals": "^17.13.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "simple-git-hooks": "^2.14.0",
        "typescript": "~6.0.3",
        "vite": "^8.3.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.147.0"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
